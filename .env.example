# Database
DATABASE_URL="postgresql://crm:crm_password@localhost:5432/crm_db"

# JWT
JWT_SECRET="change-me-min-32-chars-access-token-secret"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-token-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Redis (Phase 8+)
REDIS_URL="redis://localhost:6379"

# Storage (Phase 4+)
S3_BUCKET="crm-attachments"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Email (Phase 8+)
EMAIL_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"
