# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Firebase Admin SDK
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as a single line (or use a file path approach)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"crm-v1-d8854","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@crm-v1-d8854.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

FIREBASE_STORAGE_BUCKET="crm-v1-d8854.firebasestorage.app"
FIREBASE_PROJECT_ID="crm-v1-d8854"

# Signed URL expiry in seconds (default: 15 min)
STORAGE_PRESIGN_EXPIRY=900
