generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  manager
  sales_agent
  support
}

enum UserStatus {
  active
  inactive
}

enum CustomerStatus {
  Active
  Inactive
}

enum LeadSource {
  Website
  Referral
  Trade_Show
  Cold_Call
  Email_Campaign
  Social_Media
  Partner
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Lost
  Converted
}

enum DealStage {
  New
  Qualified
  Proposal
  Negotiation
  Won
  Lost
}

enum ActivityType {
  call
  email
  meeting
  note
  task
}

enum ActivityPriority {
  low
  medium
  high
}

enum RelatedType {
  customer
  lead
  deal
}

enum TicketStatus {
  Open
  In_Progress
  Resolved
  Closed
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum TicketChannel {
  email
  phone
  chat
  web
}

enum QuoteStatus {
  Draft
  Sent
  Accepted
  Rejected
  Expired
}

enum EntityType {
  customer
  lead
  deal
}

enum CustomFieldType {
  text
  number
  date
  select
  url
  checkbox
}

enum AuditAction {
  created
  updated
  deleted
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(sales_agent)
  status         UserStatus @default(active)
  phone          String?
  jobTitle       String?
  department     String?
  avatarInitials String
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  ownedCustomers Customer[]
  ownedLeads     Lead[]
  ownedDeals     Deal[]
  assignedTickets Ticket[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Customer {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  company      String
  jobTitle     String
  status       CustomerStatus @default(Active)
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id])
  avatarUrl    String?
  customFields Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tags         CustomerTag[]
  deals        Deal[]
  activities   Activity[]     @relation("CustomerActivities")
  attachments  Attachment[]   @relation("CustomerAttachments")
  tickets      Ticket[]
  quotes       Quote[]

  @@map("customers")
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String?
  source    LeadSource
  status    LeadStatus @default(New)
  value     Float
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tags        LeadTag[]
  activities  Activity[]   @relation("LeadActivities")
  attachments Attachment[] @relation("LeadAttachments")

  @@map("leads")
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  amount            Float
  stage             DealStage @default(New)
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id])
  expectedCloseDate String
  description       String?
  probability       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activities  Activity[]   @relation("DealActivities")
  attachments Attachment[] @relation("DealAttachments")
  quotes      Quote[]

  @@map("deals")
}

model Activity {
  id          String           @id @default(uuid())
  type        ActivityType
  title       String
  description String?
  owner       String
  completed   Boolean          @default(false)
  dueDate     DateTime?
  priority    ActivityPriority?
  relatedTo   String
  relatedType RelatedType
  relatedName String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer Customer? @relation("CustomerActivities", fields: [relatedTo], references: [id], map: "activity_customer_fk")
  lead     Lead?     @relation("LeadActivities", fields: [relatedTo], references: [id], map: "activity_lead_fk")
  deal     Deal?     @relation("DealActivities", fields: [relatedTo], references: [id], map: "activity_deal_fk")

  @@map("activities")
}

model Ticket {
  id         String         @id @default(uuid())
  subject    String
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id])
  status     TicketStatus   @default(Open)
  priority   TicketPriority @default(Medium)
  assigneeId String?
  assignee   User?          @relation(fields: [assigneeId], references: [id])
  channel    TicketChannel?
  tags       String[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  comments TicketComment[]

  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ticket_comments")
}

model Attachment {
  id          String      @id @default(uuid())
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  relatedTo   String
  relatedType RelatedType
  uploadedBy  String
  createdAt   DateTime    @default(now())

  customer Customer? @relation("CustomerAttachments", fields: [relatedTo], references: [id], map: "attachment_customer_fk")
  lead     Lead?     @relation("LeadAttachments", fields: [relatedTo], references: [id], map: "attachment_lead_fk")
  deal     Deal?     @relation("DealAttachments", fields: [relatedTo], references: [id], map: "attachment_deal_fk")

  @@map("attachments")
}

model Quote {
  id         String      @id @default(uuid())
  dealId     String?
  deal       Deal?       @relation(fields: [dealId], references: [id])
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  status     QuoteStatus @default(Draft)
  validUntil DateTime?
  notes      String?
  subtotal   Float
  tax        Float       @default(0)
  total      Float
  lineItems  Json
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("quotes")
}

model Tag {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?

  customers CustomerTag[]
  leads     LeadTag[]

  @@map("tags")
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model CustomFieldDef {
  id         String          @id @default(uuid())
  entityType EntityType
  key        String
  name       String
  type       CustomFieldType
  options    String[]
  required   Boolean         @default(false)
  createdAt  DateTime        @default(now())

  values CustomFieldValue[]

  @@unique([entityType, key])
  @@map("custom_field_defs")
}

model CustomFieldValue {
  id         String         @id @default(uuid())
  fieldDefId String
  fieldDef   CustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  entityId   String
  value      Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fieldDefId, entityId])
  @@map("custom_field_values")
}

model Segment {
  id          String     @id @default(uuid())
  name        String
  entityType  EntityType
  criteria    Json
  matchCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("segments")
}

model Workflow {
  id         String     @id @default(uuid())
  name       String
  entityType EntityType
  trigger    Json
  conditions Json?
  actions    Json
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("workflows")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid())
  entityType String
  entityId   String
  action     AuditAction
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
}
