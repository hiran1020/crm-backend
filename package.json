{
  "name": "crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:emu": "FIREBASE_EMULATOR=true tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "emulator": "npx firebase-tools emulators:start --import=.firebase-data --export-on-exit",
    "emulator:seed": "FIREBASE_EMULATOR=true tsx src/scripts/seed-emulator.ts",
    "emulator:reset": "rm -rf .firebase-data",
    "test:integration": "FIREBASE_EMULATOR=true tsx src/scripts/integration-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
